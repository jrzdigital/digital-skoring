{
  "name": "jrz-score-ipsi",
  "productName": "JRZ SCORE IPSI 2026",
  "version": "1.0.0",
  "description": "Aplikasi Digital Scoring Pencak Silat Standar IPSI 2026 & PERSILAT",
  "author": "JRZ Score",
  "private": true,
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:lightningcss --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "electron:dev": "electron .",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "electron:dist": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "build:exe": "npm run build && electron-builder --win nsis portable --x64",
    "pack:exe": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist_electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
